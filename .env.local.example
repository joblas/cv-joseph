# RAG — Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# RAG — Voyage AI Embeddings (OPTIONAL — dash.voyageai.com → API Keys — free tier).
# Without it, retrieval runs in keyword mode over the same Supabase corpus.
VOYAGE_API_KEY=pa-xxx

# Chatbot — Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxx
# …or any Anthropic-compatible endpoint (e.g. Ollama Cloud): Bearer token + base URL + model ids
# ANTHROPIC_BASE_URL=https://ollama.com
# ANTHROPIC_AUTH_TOKEN=<ollama key>
# CHAT_MODEL=glm-5.3-flash
# CHAT_MAX_TOKENS=2048   # thinking models share the budget with hidden reasoning

# Voice — OpenAI Realtime (optional — platform.openai.com → API Keys)
OPENAI_API_KEY=sk-xxx
