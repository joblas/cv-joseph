{
  "name": "voice_quality",
  "description": "Tests voice RAG endpoint (/api/rag-search): content relevance, no markdown, factual accuracy, grounding",
  "tests": [
    {
      "id": "voice-content-turnover",
      "description": "Voice RAG about the Turnover Agent returns relevant content",
      "input": "Tell me about the Turnover Agent",
      "lang": "en",
      "mode": "voice",
      "assertions": [
        {
          "type": "contains_any",
          "values": [
            "turnover",
            "telegram",
            "nick",
            "short-term",
            "rental",
            "airbnb"
          ]
        }
      ]
    },
    {
      "id": "voice-no-markdown",
      "description": "Voice RAG response must not contain markdown links",
      "input": "What projects have you built?",
      "lang": "en",
      "mode": "voice",
      "assertions": [
        {
          "type": "not_contains",
          "value": "**"
        },
        {
          "type": "regex",
          "pattern": "^(?!.*\\[.*\\]\\(.*\\)).*$",
          "flags": "s"
        }
      ]
    },
    {
      "id": "voice-factual-turnover",
      "description": "Voice RAG about the Turnover Agent should mention key details",
      "input": "Tell me about the Turnover Agent, what does it do?",
      "lang": "en",
      "mode": "voice",
      "assertions": [
        {
          "type": "contains_any",
          "values": [
            "telegram",
            "ical",
            "airbnb",
            "vrbo",
            "cleaner",
            "checkout",
            "check-in",
            "turnover"
          ]
        }
      ]
    },
    {
      "id": "voice-grounding-invented",
      "description": "Voice RAG for unknown project returns empty or no-match signal",
      "input": "Tell me about your blockchain project",
      "lang": "en",
      "mode": "voice",
      "assertions": [
        {
          "type": "contains_any",
          "values": [
            "No relevant content",
            "no tengo",
            "not",
            "unavailable",
            "general knowledge",
            "don't have"
          ]
        }
      ]
    },
    {
      "id": "voice-brevity-general",
      "description": "General voice response should be short (< 60 words)",
      "input": "Hi, who are you?",
      "lang": "es",
      "mode": "voice",
      "assertions": [
        {
          "type": "max_words",
          "value": 60
        }
      ]
    },
    {
      "id": "voice-no-urls",
      "description": "Voice RAG response should not contain URLs",
      "input": "How can I contact you?",
      "lang": "en",
      "mode": "voice",
      "assertions": [
        {
          "type": "regex",
          "pattern": "^(?!.*https?://).*$",
          "flags": "s"
        }
      ]
    }
  ]
}
