{
  "name": "factual_accuracy",
  "description": "Verifies that Joseph responds with correct CV data",
  "tests": [
    {
      "id": "exp-years",
      "description": "Should mention significant years of experience or start date",
      "input": "How many years of experience do you have?",
      "lang": "en",
      "assertions": [
        {
          "type": "contains_any",
          "values": [
            "10",
            "2015",
            "2016",
            "audio",
            "AV"
          ]
        },
        {
          "type": "not_contains",
          "value": "I don't know"
        }
      ]
    },
    {
      "id": "project-name",
      "description": "Should mention a key project name: Hermes, The Skate Workshop, or Career Ops",
      "input": "What are your main projects?",
      "lang": "en",
      "assertions": [
        {
          "type": "contains_any",
          "values": [
            "Hermes",
            "Skate Workshop",
            "Career Ops"
          ]
        }
      ]
    },
    {
      "id": "location",
      "description": "Should mention Escondido or San Diego",
      "input": "Where are you based?",
      "lang": "en",
      "assertions": [
        {
          "type": "contains_any",
          "values": [
            "Escondido",
            "San Diego",
            "California"
          ]
        }
      ]
    },
    {
      "id": "current-role",
      "description": "Should mention Quadient as current role",
      "input": "Where do you currently work?",
      "lang": "en",
      "assertions": [
        {
          "type": "contains_any",
          "values": [
            "Quadient",
            "quadient"
          ]
        }
      ]
    },
    {
      "id": "business-name",
      "description": "Should mention Joe's Tech Solutions",
      "input": "Have you had your own business?",
      "lang": "en",
      "assertions": [
        {
          "type": "contains_any",
          "values": [
            "Joe's Tech Solutions",
            "Joe's Tech"
          ]
        }
      ]
    },
    {
      "id": "target-roles",
      "description": "Should describe Joe's current positioning (forward deployed engineer / AI systems builder / autonomous systems) or route hiring to Joe",
      "input": "What roles are you interested in?",
      "lang": "en",
      "assertions": [
        {
          "type": "contains_any",
          "values": [
            "Forward Deployed",
            "forward deployed",
            "AI Systems",
            "AI systems",
            "Autonomous",
            "autonomous",
            "Joe's Tech Solutions",
            "joe@joestechsolutions.com"
          ]
        }
      ]
    },
    {
      "id": "repo-public",
      "description": "Should confirm the portfolio repo is public on GitHub",
      "input": "Is the code for cloudyjoe.com on GitHub?",
      "lang": "en",
      "assertions": [
        {
          "type": "contains_any",
          "values": [
            "public",
            "open",
            "GitHub"
          ]
        },
        {
          "type": "contains_any",
          "values": [
            "joblas",
            "cv-santiago"
          ]
        },
        {
          "type": "not_contains",
          "value": "private"
        }
      ]
    },
    {
      "id": "model-version",
      "description": "Should name the model actually serving the chat (from the runtime context), never a stale fixed version",
      "input": "What AI model do you use?",
      "lang": "en",
      "assertions": [
        {
          "type": "contains_any",
          "values": [
            "glm",
            "GLM",
            "Ollama",
            "ollama",
            "Claude"
          ]
        },
        {
          "type": "not_contains",
          "value": "3.5 Sonnet"
        },
        {
          "type": "not_contains",
          "value": "Sonnet 3.5"
        },
        {
          "type": "not_contains",
          "value": "Vercel"
        }
      ]
    },
    {
      "id": "voice-availability-truthful",
      "description": "Describing how the chat works must reflect real voice availability: with OPENAI_API_KEY unset in production it must say voice is unavailable and never invite the mic",
      "input": "How does this chatbot work? Does it have a voice mode?",
      "lang": "en",
      "assertions": [
        {
          "type": "not_contains",
          "value": "hit the mic"
        },
        {
          "type": "contains_any",
          "values": [
            "unavailable",
            "not available",
            "temporarily"
          ]
        }
      ]
    }
  ]
}
