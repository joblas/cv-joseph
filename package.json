{
  "name": "cv-joseph",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "rag:export": "tsx --tsconfig tsconfig.app.json scripts/export-chunks.ts",
    "rag:ingest": "tsx --tsconfig tsconfig.app.json scripts/ingest-rag.ts",
    "rag:sync": "npm run rag:export && npm run rag:ingest",
    "build": "npm run rag:sync && npm run prompt:sync && tsx --tsconfig tsconfig.app.json scripts/embed-evals.ts && tsx --tsconfig tsconfig.app.json scripts/update-reddit-stats.ts && tsx --tsconfig tsconfig.app.json scripts/update-github-stats.ts && tsc -b && vite build && tsx --tsconfig tsconfig.app.json scripts/generate-sitemap.ts && tsx --tsconfig tsconfig.app.json scripts/validate-articles.ts && tsx --tsconfig tsconfig.app.json scripts/validate-llms-txt.ts && tsx --tsconfig tsconfig.app.json scripts/prerender.tsx && tsx --tsconfig tsconfig.app.json scripts/validate-prerender.ts && tsx --tsconfig tsconfig.app.json scripts/indexnow-ping.ts",
    "cf:prep": "node scripts/gen-prompt-module.mjs && node scripts/prep-cf-functions.mjs",
    "cf:post": "cp cf-headers.txt dist/_headers && cp cf-redirects.txt dist/_redirects",
    "validate-llms-txt": "tsx --tsconfig tsconfig.app.json scripts/validate-llms-txt.ts",
    "validate-articles": "tsx --tsconfig tsconfig.app.json scripts/validate-articles.ts",
    "validate-articles:fix": "tsx --tsconfig tsconfig.app.json scripts/validate-articles.ts --fix",
    "lint": "eslint .",
    "preview": "vite preview",
    "evals": "tsx evals/runner.ts",
    "typecheck:evals": "tsc -p evals/tsconfig.json",
    "evaluate-traces": "tsx scripts/evaluate-traces.ts",
    "prompt:sync": "tsx scripts/sync-prompt-to-langfuse.ts",
    "prompt:regression": "tsx scripts/prompt-regression.ts",
    "adversarial": "tsx scripts/adversarial-test.ts",
    "chats": "tsx scripts/chats.ts",
    "chats:tui": "tsx scripts/chats-tui.ts",
    "test:contract": "tsx tests/ops-contract.test.ts",
    "test:ops": "tsx tests/ops-dashboard.test.ts",
    "test:personas": "npm run cf:prep >/dev/null && tsx tests/personas.test.ts",
    "test:rag-query": "npm run cf:prep >/dev/null && tsx tests/site-query-expansion.test.ts",
    "diagnose:rag": "tsx scripts/diagnose-rag.ts",
    "test:spoken": "npm run cf:prep >/dev/null && tsx tests/spoken-text.test.ts",
    "test:rag-hybrid": "npm run cf:prep >/dev/null && tsx tests/site-hybrid-retrieval.test.ts",
    "test:voice-search": "npm run cf:prep >/dev/null && tsx tests/rag-search-voice.test.ts",
    "test:agent-prompts": "npm run cf:prep >/dev/null && tsx tests/jts-agent-prompts.test.ts",
    "test:voice-client": "tsx tests/voice-search-client.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@supabase/supabase-js": "^2.99.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/functions": "^3.3.6",
    "langfuse": "^3.38.6",
    "lucide-react": "^0.563.0",
    "motion": "^12.29.0",
    "openai": "^6.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.8.0",
    "resend": "^6.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "critters": "^0.0.23",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "simple-icons": "^16.11.0",
    "tailwindcss": "^4.1.18",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wrangler": "^4.131.1"
  }
}
